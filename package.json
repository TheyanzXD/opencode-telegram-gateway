{
  "name": "opencode-gateway-telegram",
  "version": "1.0.0",
  "description": "Telegram bot gateway to multiple OpenAI-compatible LLM providers. Streaming, vision, per-user model selection, SQLite history, admin panel, CLI setup wizard.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "opencode-gateway": "bin/opencode-gateway.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "setup": "node bin/opencode-gateway.js setup",
    "interactive": "node bin/opencode-gateway.js tui",
    "test": "node --test tests/",
    "lint": "node scripts/lint.js",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.7",
    "grammy": "^1.36.3",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "undici": "^7.2.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  },
  "keywords": [
    "telegram",
    "bot",
    "openai",
    "llm",
    "gateway",
    "router",
    "multi-provider"
  ],
  "license": "MIT"
}
