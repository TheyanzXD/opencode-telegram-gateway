# =====================================================
# OpenCode Gateway — Telegram bot for OpenAI-compatible LLMs
# =====================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Only TELEGRAM_BOT_TOKEN is strictly required. Everything else has a
# working default below. Your .env is gitignored — never commit it.

# ---- Telegram ----
# Get a token from @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated user IDs allowed to talk to the bot.
# Get yours from @userinfobot. Leave blank to allow everyone (public bot).
TELEGRAM_ALLOWED_USERS=123456789
# Optional: comma-separated admin IDs (can use /admin commands)
TELEGRAM_ADMIN_USERS=
# ---- RBAC: who may run tools ----
# Chat access above is one tier. These are the tiers below and above it:
#   TELEGRAM_TOOL_USERS — run file/terminal tools, get dangerous-tool approval
#                          prompts directly (no inline keyboard needed).
#   TELEGRAM_ADMIN_USERS — the tier above tool users: /admin commands too.
# Both blank (default): every dangerous tool shows a one-tap Approve/Reject
# keyboard, and operator-only tools are refused.
TELEGRAM_TOOL_USERS=
# ---- Embeddings & images (optional) ----
# Point these at a provider that offers /embeddings and /images/generations.
# Without them the RAG layer still works but is keyword-adjacent, and
# image_generate tells you it is unconfigured rather than failing silently.
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# IMAGE_PROVIDER=openai
# IMAGE_MODEL=dall-e-3

# Voice output — a provider with an audio model (optional)
# TTS_PROVIDER=openai
# TTS_MODEL=tts-1
# TTS_VOICE=alloy

# Optional: a delivery channel for scheduled tasks
# TELEGRAM_HOME_CHANNEL=-1001234567890

# ---- Default provider & model ----
# Provider must exist in providers.yaml. "openrouter" gives you free models.
DEFAULT_PROVIDER=openrouter
DEFAULT_MODEL=deepseek/deepseek-chat-v3-0324:free
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=4096

# ---- API keys (referenced by name from providers.yaml) ----
# Fill the one for your DEFAULT_PROVIDER; the rest are optional.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEEPINFRA_API_KEY=
GROQ_API_KEY=

# ---- System prompt (sent on every fresh conversation) ----
# One line only — this parser reads line by line, so a wrapped prompt is
# truncated at the first newline. Long version + rationale:
#   prompts/default.md
# Keep it short: it is prepended to every call and billed per token.
SYSTEM_PROMPT=You are the OpenCode Gateway — a direct, capable relay between Telegram and a frontier model. Answer the question asked; build the thing requested. No padding, no hedging, no filler ("I'd be happy to", "Let me"), no sign-offs, no lectures. If the request is ambiguous in a way that changes the deliverable, ask one short question; otherwise infer the strongest reading and build. Match the user's language and register. § FORMAT — you render as Bot API v1 Markdown in a 4096-char window: `*bold*`, `_italic_`, `` `code` ``, `[text](url)`; there are no headings/lists/tables. Underscores inside a word (`user_model_name`) parse as italic and reject the whole reply — put identifiers in code spans. Keep every marker balanced; one stray `*` kills the message. Wrap code, paths, and model IDs in backticks. § CAPABILITY — you work across code, RE, infra, and security research. Build technical requests with real APIs and real detail; name failure modes inline, one line. You have no shell and cannot touch the host — if something must run, give the command. § MEMORY — you see the last ~20 turns, nothing else: no files, no cross-user recall. § ERRORS — surface them raw: `HTTP 401: invalid_api_key` is useful, "something went wrong" is not. If you don't know, say so.

# ---- Database ----
DB_PATH=./data/gateway.db

# ---- Logging ----
LOG_LEVEL=info
# "pretty" (dev) or "json" (production)
LOG_FORMAT=pretty
LOG_FILE=

# ---- HTTP ----
# Per-request timeout in ms for LLM API calls
REQUEST_TIMEOUT_MS=120000

# ---- Vision ----
# When user sends an image, run this model (must support vision).
# Leave empty to skip vision forwarding.
VISION_PROVIDER=
VISION_MODEL=

# ---- Conversation ----
# Max messages kept in context (per user)
HISTORY_LIMIT=20
# Max characters per user message
MAX_INPUT_CHARS=8000
# Stream responses
STREAMING=true

# ---- Proxy pool (optional) ----
# Free public proxy pool, rotated per chat. Set false to disable.
PROXY_ENABLED=false
PROXY_TARGET=10000
PROXY_PER_CHAT=true
PROXY_REFRESH_HOURS=6
# Optional: a local file of authenticated proxies (user:pass@ip:port,
# one per line, socks5). Gitignored — never commit credentials.
# PROXY_PREMIUM_FILE=/path/to/premium-proxy-list.txt

# ---- Browser ----
# The browser is agent tools: /agent "<task>" calls browser_navigate,
# browser_snapshot (@eN refs), browser_click, browser_type, browser_read,
# browser_search. There is no /browse command.
#
# Camoufox (anti-detect Firefox) is the only backend. It is fetched once:
#   npx camou install
# src/bootstrap.js resolves the install from the camou CLI registry at startup,
# so no env here is needed for it. Leave this section commented unless you are
# debugging a resolution failure.

# ---- Admin ----
# When true, /admin commands only work in TELEGRAM_HOME_CHANNEL.
ADMIN_REQUIRE_CHANNEL=true

# ---- Agent harness (file tools + bash) ----
# Master switch. When false, bot is plain chat.
AGENT_ENABLED=true
# Default cwd when the user hasn't set one with /cwd. Falls back to bot cwd.
DEFAULT_CWD=
# Max ms before a bash command is killed (also capped at 120000).
AGENT_BASH_TIMEOUT_MS=30000
# Inline approval lifetime before auto-deny (ms).
AGENT_APPROVAL_TTL_MS=300000
# Max tool-call iterations per user turn.
AGENT_MAX_ITERATIONS=12
# Max bytes returned by read_file (cap message length).
AGENT_MAX_FILE_BYTES=200000
# Max bytes returned by bash_exec (combined stdout+stderr).
AGENT_MAX_BASH_OUTPUT_BYTES=50000
# Max lines returned by read_file.
AGENT_MAX_FILE_LINES=2000
# Max size of a document the bot will read from a Telegram upload (bytes).
AGENT_MAX_UPLOAD_BYTES=200000
# Suggest "send as file" when read_file output exceeds this many lines.
AGENT_SEND_FILE_THRESHOLD_LINES=200

# ---- Per-user storage ----
# Where per-user SQLite files go. One file per user.
TENANT_DIR=./data/tenants

# ---- Webhook mode (leave WEBHOOK_DOMAIN empty for polling) ----
WEBHOOK_ENABLED=false
WEBHOOK_DOMAIN=
WEBHOOK_PORT=8443
WEBHOOK_PATH=/telegram
WEBHOOK_SECRET=

# ---- MCP (Model Context Protocol) ----
# Path to mcp.json describing MCP servers to connect to.
MCP_CONFIG=./mcp.json
# Auto-start MCP servers on bot launch.
MCP_AUTO_START=true

# ---- Memory (FTS5 keyword search) ----
# Auto-remember tool outputs and important facts. v1 = no embeddings, BM25 only.
MEMORY_AUTO_REMEMBER=true
# Default k for memory_recall.
MEMORY_MAX_RECALL=5
