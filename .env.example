# =====================================================
# OpenCode Gateway — Telegram bot for OpenAI-compatible LLMs
# =====================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Only TELEGRAM_BOT_TOKEN is strictly required. Everything else has a
# working default below. Your .env is gitignored — never commit it.

# ---- Telegram ----
# Get a token from @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated user IDs allowed to talk to the bot.
# Get yours from @userinfobot. Leave blank to allow everyone (public bot).
TELEGRAM_ALLOWED_USERS=123456789
# Optional: comma-separated admin IDs (can use /admin commands)
TELEGRAM_ADMIN_USERS=
# Optional: a delivery channel for scheduled tasks
# TELEGRAM_HOME_CHANNEL=-1001234567890

# ---- Default provider & model ----
# Provider must exist in providers.yaml. "openrouter" gives you free models.
DEFAULT_PROVIDER=openrouter
DEFAULT_MODEL=deepseek/deepseek-chat-v3-0324:free
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=4096

# ---- API keys (referenced by name from providers.yaml) ----
# Fill the one for your DEFAULT_PROVIDER; the rest are optional.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEEPINFRA_API_KEY=
GROQ_API_KEY=

# ---- System prompt (sent on every fresh conversation) ----
SYSTEM_PROMPT=You are a helpful assistant. Be concise. Use Markdown when appropriate.

# ---- Database ----
DB_PATH=./data/gateway.db

# ---- Logging ----
LOG_LEVEL=info
# "pretty" (dev) or "json" (production)
LOG_FORMAT=pretty
LOG_FILE=

# ---- HTTP ----
# Per-request timeout in ms for LLM API calls
REQUEST_TIMEOUT_MS=120000

# ---- Vision ----
# When user sends an image, run this model (must support vision).
# Leave empty to skip vision forwarding.
VISION_PROVIDER=
VISION_MODEL=

# ---- Conversation ----
# Max messages kept in context (per user)
HISTORY_LIMIT=20
# Max characters per user message
MAX_INPUT_CHARS=8000
# Stream responses
STREAMING=true

# ---- Proxy pool (optional) ----
# Free public proxy pool, rotated per chat. Set false to disable.
PROXY_ENABLED=true
PROXY_TARGET=10000
PROXY_PER_CHAT=true
PROXY_REFRESH_HOURS=6

# ---- Admin ----
# When true, /admin commands only work in TELEGRAM_HOME_CHANNEL.
ADMIN_REQUIRE_CHANNEL=true

# ---- Agent harness (file tools + bash) ----
# Master switch. When false, bot is plain chat.
AGENT_ENABLED=true
# Default cwd when the user hasn't set one with /cwd. Falls back to bot cwd.
DEFAULT_CWD=
# Max ms before a bash command is killed (also capped at 120000).
AGENT_BASH_TIMEOUT_MS=30000
# Inline approval lifetime before auto-deny (ms).
AGENT_APPROVAL_TTL_MS=300000
# Max tool-call iterations per user turn.
AGENT_MAX_ITERATIONS=12
# Max bytes returned by read_file (cap message length).
AGENT_MAX_FILE_BYTES=200000
# Max bytes returned by bash_exec (combined stdout+stderr).
AGENT_MAX_BASH_OUTPUT_BYTES=50000
# Max lines returned by read_file.
AGENT_MAX_FILE_LINES=2000
# Max size of a document the bot will read from a Telegram upload (bytes).
AGENT_MAX_UPLOAD_BYTES=200000
# Suggest "send as file" when read_file output exceeds this many lines.
AGENT_SEND_FILE_THRESHOLD_LINES=200

# ---- Per-user storage ----
# Where per-user SQLite files go. One file per user.
TENANT_DIR=./data/tenants

# ---- Webhook mode (leave WEBHOOK_DOMAIN empty for polling) ----
WEBHOOK_ENABLED=false
WEBHOOK_DOMAIN=
WEBHOOK_PORT=8443
WEBHOOK_PATH=/telegram
WEBHOOK_SECRET=

# ---- MCP (Model Context Protocol) ----
# Path to mcp.json describing MCP servers to connect to.
MCP_CONFIG=./mcp.json
# Auto-start MCP servers on bot launch.
MCP_AUTO_START=true

# ---- Memory (FTS5 keyword search) ----
# Auto-remember tool outputs and important facts. v1 = no embeddings, BM25 only.
MEMORY_AUTO_REMEMBER=true
# Default k for memory_recall.
MEMORY_MAX_RECALL=5
