# =====================================================
# OpenCode Gateway — Telegram bot for OpenAI-compatible LLMs
# =====================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Only TELEGRAM_BOT_TOKEN is strictly required. Everything else has a
# working default below. Your .env is gitignored — never commit it.

# ---- Telegram ----
# Get a token from @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated user IDs allowed to talk to the bot.
# Get yours from @userinfobot. Leave blank to allow everyone (public bot).
TELEGRAM_ALLOWED_USERS=123456789
# Optional: comma-separated admin IDs (can use /admin commands)
TELEGRAM_ADMIN_USERS=
# Optional: a delivery channel for scheduled tasks
# TELEGRAM_HOME_CHANNEL=-1001234567890

# ---- Default provider & model ----
# Provider must exist in providers.yaml. "openrouter" gives you free models.
DEFAULT_PROVIDER=openrouter
DEFAULT_MODEL=deepseek/deepseek-chat-v3-0324:free
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=4096

# ---- API keys (referenced by name from providers.yaml) ----
# Fill the one for your DEFAULT_PROVIDER; the rest are optional.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEEPINFRA_API_KEY=
GROQ_API_KEY=

# ---- System prompt (sent on every fresh conversation) ----
SYSTEM_PROMPT=You are a helpful assistant. Be concise. Use Markdown when appropriate.

# ---- Database ----
DB_PATH=./data/gateway.db

# ---- Logging ----
LOG_LEVEL=info
# "pretty" (dev) or "json" (production)
LOG_FORMAT=pretty
LOG_FILE=

# ---- HTTP ----
# Per-request timeout in ms for LLM API calls
REQUEST_TIMEOUT_MS=120000

# ---- Vision ----
# When user sends an image, run this model (must support vision).
# Leave empty to skip vision forwarding.
VISION_PROVIDER=
VISION_MODEL=

# ---- Conversation ----
# Max messages kept in context (per user)
HISTORY_LIMIT=20
# Max characters per user message
MAX_INPUT_CHARS=8000
# Stream responses
STREAMING=true

# ---- Proxy pool (optional) ----
# Free public proxy pool, rotated per chat. Set false to disable.
PROXY_ENABLED=true
PROXY_TARGET=10000
PROXY_PER_CHAT=true
PROXY_REFRESH_HOURS=6
# Optional: a local file of authenticated proxies (user:pass@ip:port,
# one per line, socks5). Gitignored — never commit credentials.
# PROXY_PREMIUM_FILE=/path/to/premium-proxy-list.txt

# ---- Admin ----
# When true, /admin commands only work in TELEGRAM_HOME_CHANNEL.
ADMIN_REQUIRE_CHANNEL=true
