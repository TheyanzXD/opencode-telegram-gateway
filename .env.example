# =====================================================
# OpenCode Gateway — Telegram bot for OpenAI-compatible LLMs
# =====================================================
# Copy to .env and fill in your values.

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_ALLOWED_USERS=123456789,987654321
# Optional: a default delivery channel for cron jobs / scheduled tasks
# TELEGRAM_HOME_CHANNEL=-1001234567890
# Optional: comma-separated admin user IDs (can manage providers/models)
TELEGRAM_ADMIN_USERS=

# ---- Default provider & model ----
# Provider name must match a key in providers.yaml
DEFAULT_PROVIDER=openai
DEFAULT_MODEL=gpt-4o-mini
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=4096

# ---- System prompt (sent on every fresh conversation) ----
SYSTEM_PROMPT=You are a helpful assistant. Be concise. Use Markdown when appropriate.

# ---- Database ----
DB_PATH=./data/gateway.db

# ---- Logging ----
LOG_LEVEL=info
# Set to "pretty" for human-readable logs (dev), "json" for production
LOG_FORMAT=pretty
LOG_FILE=

# ---- HTTP ----
# Per-request timeout in ms for LLM API calls
REQUEST_TIMEOUT_MS=120000

# ---- Misc ----
# Vision: when user sends image, run this model (must support vision).
# Leave empty to skip vision forwarding.
VISION_PROVIDER=
VISION_MODEL=
# Max conversation history messages kept in context (per user)
HISTORY_LIMIT=20
# Max characters per user message (above this, bot replies with a warning)
MAX_INPUT_CHARS=8000
# Stream responses (set "false" to always wait for full reply)
STREAMING=true

# ---- Proxy pool ----
# Master switch (set false to disable the proxy pool entirely).
PROXY_ENABLED=true
# Target pool size — bot auto-fetches up to this many public proxies at startup.
PROXY_TARGET=10000
# Stable per-chat rotation: each chatId hashes to a specific proxy entry.
PROXY_PER_CHAT=true
# Hours between automatic refresh + sweep.
PROXY_REFRESH_HOURS=6

# ---- Admin ----
# When true, admin commands (/admin, /sessions export) only work in TELEGRAM_HOME_CHANNEL.
ADMIN_REQUIRE_CHANNEL=true
